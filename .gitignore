node_modules/
**/node_modules/

# TypeScript / build outputs
apps/desktop/dist/
packages/shared-types/dist/
packages/shared-types/src/*.js
packages/shared-types/src/*.d.ts
packages/shared-types/src/*.js.map
dist/
**/*.tsbuildinfo

# Go build outputs and caches
daemon/bin/
daemon/*.exe
daemon/**/*.syso
.cache/
.claude/
docs/CLAUDE.md
daemon/coverage.out
coverage.out

# Android / Gradle build outputs (mirrors apps/android/.gitignore, which only
# exists on the android branch — these keep master's status clean too)
apps/android/.gradle/
apps/android/.kotlin/
apps/android/**/build/
apps/android/local.properties
apps/android/core/libs/*.aar
apps/android/core/libs/*.jar

# Installer / packaging artifacts
apps/desktop/release/
apps/desktop/out/
apps/desktop/.webpack/

# Logs / temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
tmp/

# OS/editor noise
.DS_Store
Thumbs.db

# pnpm (not adopted yet — npm/package-lock.json is authoritative)
pnpm-lock.yaml
pnpm-workspace.yaml
