    <string name="settings_censorship_heading">Censorship Bypass</string>
    <string name="settings_censorship_last_method">At least one connection method must stay on.</string>
    <string name="settings_censorship_normal_hint">Ordinary HTTPS using a normal DNS lookup. Tried last, because it is the only method that reveals our domain on the network.</string>
    <string name="settings_censorship_normal_title">Normal connection</string>
    <string name="settings_censorship_shadowsocks_hint">Route account traffic through a Shadowsocks tunnel. Hides which server you are contacting, without turning the VPN on.</string>
    <string name="settings_censorship_shadowsocks_title">Shadowsocks</string>
    <string name="settings_network_allowlan_hint">Let local-network traffic (router, printers, captive portals) bypass the tunnel. Turn on if your Wi-Fi intermittently drops to \"No internet\" while connected. Takes effect on next connect.</string>
