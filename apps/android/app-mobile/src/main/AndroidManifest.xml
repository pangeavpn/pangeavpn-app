<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Launchable apps only, so the split-tunnel picker needs no
         QUERY_ALL_PACKAGES and stays within Play policy. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <!-- The Kill Switch page offers its settings button only when this resolves. -->
        <intent>
            <action android:name="android.settings.VPN_SETTINGS" />
        </intent>
    </queries>

    <!-- Showing the account number asks for the screen lock or a fingerprint first. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Restated from :core's manifest, which the merger folds in anyway:
         nothing here should survive an adb backup or a device transfer. -->
    <application
        android:name=".PangeaApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Pangea">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Pangea">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PangeaTileService"
            android:exported="true"
            android:icon="@drawable/ic_stat_pangea"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

    </application>

</manifest>
