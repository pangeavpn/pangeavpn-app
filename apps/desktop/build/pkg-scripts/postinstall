#!/bin/sh
set -eu

APP_NAME="PangeaVPN.app"
SERVICE_LABEL="com.pangea.pangeavpn.daemon"
SERVICE_PLIST="/Library/LaunchDaemons/${SERVICE_LABEL}.plist"
SERVICE_NAME="system/${SERVICE_LABEL}"
SYSTEM_SUPPORT_DIR="/Library/Application Support/PangeaVPN"
SYSTEM_DAEMON_PATH="${SYSTEM_SUPPORT_DIR}/PangeaDaemon"
LOG_PATH="/var/log/pangeavpn-daemon.log"

# ── Give the user back their own app files ──────────────────────────────────
# Up to 0.6.0 an app installed this way elevated its own daemon, which took
# root ownership of these — every later write from the app then failed EACCES.
USER_LIBRARY_ITEMS="Library/Application Support/pangeavpn-desktop
Library/Application Support/PangeaVPN
Library/Caches/PangeaVPN
Library/Caches/com.pangea.pangeavpn
Library/Containers/com.pangea.pangeavpn
Library/HTTPStorages/com.pangea.pangeavpn
Library/Logs/PangeaVPN
Library/Preferences/com.pangea.pangeavpn.plist
Library/Saved Application State/com.pangea.pangeavpn.savedState"

# Those same root mkdir -p calls could have created the parents too. Fixed
# without -R: the rest of Application Support is nothing to do with us.
USER_LIBRARY_PARENTS="Library
Library/Application Support
Library/Caches"

# Installer.app has no login context, so the console owner is the only clue.
# install-mac.sh runs us under sudo, where SUDO_USER is the better answer.
resolve_target_user() {
  user="$(/usr/bin/stat -f %Su /dev/console 2>/dev/null || true)"
  case "${user}" in
    ""|root|loginwindow) user="${SUDO_USER:-}" ;;
  esac
  printf "%s" "${user}"
}

user_home_dir() {
  home="$(/usr/bin/dscl . -read "/Users/$1" NFSHomeDirectory 2>/dev/null \
    | /usr/bin/sed -n 's/^NFSHomeDirectory: //p')"
  printf "%s" "${home:-/Users/$1}"
}

repair_user_library_ownership() {
  user="$1"
  home="$2"
  group="$(/usr/bin/id -gn "${user}" 2>/dev/null || true)"
  [ -n "${group}" ] || group="staff"

  # Here-documents, not pipes: a piped while runs in a subshell, and these
  # paths hold spaces that word splitting would tear apart.
  while IFS= read -r item; do
    [ -n "${item}" ] || continue
    target="${home}/${item}"
    # A symlink here is tampering, never ours to repair: chown would follow it
    # and hand the caller whatever system directory it points at.
    [ ! -L "${target}" ] || continue
    [ -d "${target}" ] || continue
    [ "$(/usr/bin/stat -f %Su "${target}" 2>/dev/null)" = "root" ] || continue
    /usr/sbin/chown "${user}:${group}" "${target}" >/dev/null 2>&1 || true
  done <<PARENTS
${USER_LIBRARY_PARENTS}
PARENTS

  while IFS= read -r item; do
    [ -n "${item}" ] || continue
    target="${home}/${item}"
    [ ! -L "${target}" ] || continue
    [ -e "${target}" ] || continue
    stray="$(/usr/bin/find "${target}" ! -user "${user}" -print 2>/dev/null | /usr/bin/head -1 || true)"
    [ -n "${stray}" ] || continue
    # -P so a symlink deeper in the tree is changed itself, never followed.
    /usr/sbin/chown -R -P "${user}:${group}" "${target}" >/dev/null 2>&1 || true
  done <<ITEMS
${USER_LIBRARY_ITEMS}
ITEMS
}

# Before the app lookup below, which exits early when the bundle is missing.
target_user="$(resolve_target_user)"
if [ -n "${target_user}" ] && [ "${target_user}" != "root" ]; then
  target_home="$(user_home_dir "${target_user}")"
  # Their own home, or we are being pointed somewhere we have no business in.
  if [ -d "${target_home}" ] && [ ! -L "${target_home}" ] \
    && [ "$(/usr/bin/stat -f %Su "${target_home}" 2>/dev/null)" = "${target_user}" ]; then
    # Never fatal under set -e: a permissions repair must not fail the install.
    repair_user_library_ownership "${target_user}" "${target_home}" || true
  fi
fi

install_base="${2:-/Applications}"
volume_root="${3:-/}"
app_path=""
candidate_a="${volume_root%/}${install_base%/}/${APP_NAME}"
candidate_b="${install_base%/}/${APP_NAME}"
candidate_c="/Applications/${APP_NAME}"

for candidate in "$candidate_a" "$candidate_b" "$candidate_c"; do
  if [ -x "${candidate}/Contents/Resources/daemon/daemon" ]; then
    app_path="${candidate}"
    break
  fi
done

if [ -z "${app_path}" ]; then
  # Read via a here-document rather than a pipe so the assignment survives:
  # a piped `while` runs in a subshell, and world-writable /tmp is unsafe here.
  mdfind_output="$(/usr/bin/mdfind 'kMDItemCFBundleIdentifier == "com.pangea.pangeavpn"' 2>/dev/null || true)"
  if [ -n "${mdfind_output}" ]; then
    while IFS= read -r candidate; do
      if [ -n "${candidate}" ] && [ -x "${candidate}/Contents/Resources/daemon/daemon" ]; then
        app_path="${candidate}"
        break
      fi
    done <<MDFIND
${mdfind_output}
MDFIND
  fi
fi

if [ -z "${app_path}" ]; then
  echo "PangeaVPN.app not found in expected install locations; skipping launchd setup"
  exit 0
fi
daemon_src="${app_path}/Contents/Resources/daemon/daemon"

/bin/mkdir -p "${SYSTEM_SUPPORT_DIR}"

# A downloaded .pkg propagates com.apple.quarantine to everything it extracts,
# and Gatekeeper kills quarantined unsigned binaries on Apple Silicon.
/usr/bin/xattr -dr com.apple.quarantine "${app_path}" >/dev/null 2>&1 || true

# WireGuard and Cloak run in-process inside the daemon, so only the daemon
# binary itself needs to be staged.
/usr/bin/install -m 755 -o root -g wheel "${daemon_src}" "${SYSTEM_DAEMON_PATH}"
/usr/sbin/chown root:wheel "${SYSTEM_SUPPORT_DIR}"
/bin/chmod 755 "${SYSTEM_SUPPORT_DIR}"

# Copying can invalidate the ad-hoc signature Apple Silicon requires, so the
# installed daemon is stripped and re-signed here.
/usr/bin/xattr -dr com.apple.quarantine "${SYSTEM_SUPPORT_DIR}" >/dev/null 2>&1 || true
/usr/bin/codesign --force --sign - "${SYSTEM_DAEMON_PATH}" >/dev/null 2>&1 || true

# Do NOT start the daemon here — install-mac.sh owns token creation, plist
# registration, and startup. Starting it tokenless crash-loops under KeepAlive.

exit 0
